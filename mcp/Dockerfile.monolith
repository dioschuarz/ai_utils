# Single-Container Monolithic 9-in-1 Financial MCP Server Dockerfile

# --- Stage 1: Builder ---
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=300

# Install build dependencies for C extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    make \
    gcc \
    g++ \
    libpq-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install unified dependencies into virtual environment
RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv /app/.venv && \
    uv pip install --python /app/.venv/bin/python \
    fastmcp fastapi uvicorn pydantic pandas numpy yfinance mplfinance psycopg psycopg-binary httpx beautifulsoup4 lxml tenacity tabulate requests trafilatura pandas_ta rapidfuzz python-dotenv

COPY . /app/

RUN cp /app/macro_indicators/production_macro_indicators.json /app/production_macro_indicators.json || true

RUN find /app/.venv -name "*.pyc" -delete && \
    find /app/.venv -name "__pycache__" -delete

# --- Stage 2: Minimal Production Runtime ---
FROM python:3.12-slim

WORKDIR /app

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    MALLOC_TRIM_THRESHOLD_=100000 \
    MPLCONFIGDIR=/tmp/matplotlib

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app /app

EXPOSE 8000

CMD ["uvicorn", "monolith_server:app", "--host", "0.0.0.0", "--port", "8000"]
